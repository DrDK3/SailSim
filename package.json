{
  "name": "squib-dart-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Squib sailing simulator for the River Dart (Royal Dart Yacht Club)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run check:secrets",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scenario": "tsx tools/scenario-runner.ts",
    "polar": "tsx tools/model-polar.ts",
    "params": "tsx tools/param-table.ts",
    "golden:update": "tsx tools/golden.ts",
    "calibrate": "tsx tools/calibrate.ts",
    "perf": "tsx tools/perf.ts",
    "ai:polar": "tsx tools/ai-polar.ts",
    "ai:trials": "tsx tools/ai-trials.ts",
    "check:secrets": "tsx tools/check-secrets.ts dist"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
